# Copy to .env and fill in. .env is gitignored -- never commit real values.

# DigitalOcean Gradient AI Serverless Inference model access key (sk-do-...).
# Absent by default. If absent, live inference is skipped entirely -- this is
# an expected, non-blocking state; the mock provider covers the full test suite.
DO_INFERENCE_KEY=

# Base URL for the DigitalOcean serverless inference endpoint.
DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1

# Model id. openai-gpt-oss-20b is the cheapest serverless option and the default --
# see README "Product findings" for why meta-llama-3-8b-instruct (the spec's
# original model) is not usable here.
BATCHENGINE_MODEL=openai-gpt-oss-20b

# Default max_tokens per request. Kept low because output tokens dominate cost.
BATCHENGINE_MAX_TOKENS=128

# Account rate limit, requests/minute (DigitalOcean Tier 1 default).
BATCHENGINE_RATE_LIMIT_RPM=120

# Spend guards -- see docs/decisions.md "Spend guard".
BATCHENGINE_MAX_JOB_SPEND_USD=0.25
BATCHENGINE_MAX_TOTAL_SPEND_USD=1.00

# Sample size for a "live" job when DO_INFERENCE_KEY is present but the caller
# didn't request a full run. Full 1000-item live runs must be explicit.
BATCHENGINE_LIVE_SAMPLE_SIZE=50

# SQLite path for job store persistence.
BATCHENGINE_DB_PATH=./data/jobs.db

# Directory where per-job JSONL result files are written.
BATCHENGINE_RESULTS_DIR=./data/results

# Optional: enable DigitalOcean Spaces checkpointing (§8.1). Off by default.
BATCHENGINE_SPACES_ENABLED=false
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=nyc3

# Optional: allow webhook URLs that resolve to private/loopback ranges.
# Leave false in any environment reachable from the internet (SSRF guard).
BATCHENGINE_ALLOW_PRIVATE_WEBHOOKS=false
